# Copy to .env.local and fill in real values. NEVER commit .env.local.
# All of these are server-side only — none are sent to the browser.

# ---- MongoDB ----
# Special characters in the password must be URL-encoded (e.g. "@" -> %40)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/kailvarn?retryWrites=true&w=majority
MONGODB_DB=kailvarn

# ---- Backblaze B2 (S3-compatible API) ----
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
# Folder prefix for all objects (needed if the key is restricted to a name prefix)
B2_KEY_PREFIX=Kailvarn/
# Optional: public bucket / CDN base URL. Empty = images served via /api/media/<key>
B2_PUBLIC_URL=

# ---- Admin auth ----
# Random secret (32+ chars) that signs the admin session cookie:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Set both with:  node tools/set-admin-password.mjs
ADMIN_EMAIL=admin@example.com
# bcrypt hash. In .env files every "$" must be escaped as "\$" (the tool does this).
# In a hosting panel's env settings paste the raw hash (no backslashes).
ADMIN_PASSWORD_HASH=
# Only if the site is served over plain HTTP in production:
# COOKIE_SECURE=false

# ---- Existing features ----
GOOGLE_API_KEY=
HF_TOKEN=

# Website chatbot (app/api/chat/route.js) -- OpenRouter, https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, comma-separated fallbacks. Default: apodex/apodex-1.1-mini:free
OPENROUTER_MODEL=
